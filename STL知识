#include<algorithm>
void test05()
{
	//单端动态数组vector
	vector<int> v;  //v就是一个具体的vector容器
	v.push_back(100);
	v.push_back(200);
	v.push_back(300);
	v.push_back(400);
	
	//定义一个迭代器，存储v的起始迭代器和结束迭代器
	vector<int>::iterator beginInt = v.begin();
	vector<int>::iterator endInt = v.end();
	for (; beginInt != endInt;beginInt++)
	{
		//对迭代器取*, 代表的是容器的元素
		cout << "it=" << *beginInt << " " ;
	}
	cout << endl;
	//for循环遍历2
	for (vector<int>::iterator it = v.begin(); it != v.end(); it++)
	{
		cout << *it << endl;
	}
	//for循环遍历3
	for (const auto& i : v)
	{
		cout << i << endl;
	}
	//for_each()方法：STL提供的算法来遍历容器元素
	//my_printInt()： 自己实现的打印方式
	for_each(v.begin(), v.end(), my_PrintInt);

}
void my_PrintInt(int val)
{
	cout << val << endl;
}
